var vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;

uniform mat4 ModelViewMatrix;
uniform mat4 ModelViewProjectionMatrix;
uniform mat4 NormalMatrix;
uniform vec3 u_lightPosition;

varying vec3 v_color;

void main() {
    vec4 viewPos4 = ModelViewMatrix * vec4(vertex, 1.0);
    vec3 viewPos = viewPos4.xyz;

    vec3 N = normalize((NormalMatrix * vec4(normal, 0.0)).xyz);
    vec3 L = normalize(u_lightPosition - viewPos);
    vec3 V = normalize(-viewPos);
    vec3 R = reflect(-L, N);

    vec3 ambientColor = vec3(0.1, 0.1, 0.15);
    vec3 lightColor   = vec3(1.0, 1.0, 1.0);
    vec3 surfaceColor = vec3(0.8, 0.5, 0.02);
    float shininess = 64.0;

    float diff = max(dot(N, L), 0.0);

    float spec = 0.0;
    if (diff > 0.0)
        spec = pow(max(dot(V, R), 0.0), shininess);

    vec3 ambient  = ambientColor * surfaceColor;
    vec3 diffuse  = surfaceColor * diff;
    vec3 specular = lightColor * spec;

    v_color = ambient + diffuse + specular;

    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;

var fragmentShaderSource = `
precision mediump float;

varying vec3 v_color;

void main() {
    gl_FragColor = vec4(v_color, 1.0);
}
`;
